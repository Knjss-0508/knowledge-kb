[Unit]
Description=知识库中台飞书机型配置同步
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/knowledge-kb
EnvironmentFile=-/etc/knowledge-kb/model-configuration-sync.env
ExecStart=/usr/bin/python3 /opt/knowledge-kb/scripts/sync_model_configurations_scheduler.py
NoNewPrivileges=true
PrivateTmp=true
TimeoutStartSec=45min
