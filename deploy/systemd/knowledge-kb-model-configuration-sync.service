[Unit]
Description=知识库中台飞书机型配置同步
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
Environment=HOME=/root
WorkingDirectory=/opt/knowledge-kb-model-sync
EnvironmentFile=/opt/knowledge-kb-model-sync/model-configuration-sync.env
ExecStart=/usr/bin/python3 /opt/knowledge-kb-model-sync/sync_model_configurations_scheduler.py
NoNewPrivileges=true
PrivateTmp=true
UMask=0077
TimeoutStartSec=45min
