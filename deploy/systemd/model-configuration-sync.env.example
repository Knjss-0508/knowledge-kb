# 复制到 /opt/knowledge-kb-model-sync/model-configuration-sync.env 后按实际环境修改。
# 这里不放飞书应用密钥；lark-cli 的 bot 配置应由服务器上的 root 用户单独完成。
MODEL_CONFIG_SYNC_IDENTITY=bot
# 单表兼容模式使用以下三项。启用 Wiki 多来源模式后，它们不会限制发现范围。
MODEL_CONFIG_SYNC_SPREADSHEET_TOKEN=TLxlsXMKJhPn1htD31lcdl2enKd
MODEL_CONFIG_SYNC_SHEET_ID=w3Caff
MODEL_CONFIG_SYNC_CATEGORY_ID=119
MODEL_CONFIG_SYNC_CATEGORY_NAME=平板电脑
MODEL_CONFIG_SYNC_SHEET_NAME=个性化配置信息
# Wiki 多来源模式：复制 model-configuration-sources.example.json 为下方路径后启用。
MODEL_CONFIG_SYNC_WIKI_ROOT=https://zhuanspirit.feishu.cn/wiki/HtX2wadYhiqsdwk7Q4yctvNDnlc
MODEL_CONFIG_SYNC_SOURCE_CONFIG=/opt/knowledge-kb-model-sync/model-configuration-sources.json
MODEL_CONFIG_SYNC_WIKI_MAX_PAGES=200
MODEL_CONFIG_SYNC_TARGET=local
MODEL_CONFIG_SYNC_STATE_DIR=/opt/knowledge-kb-model-sync/state
MODEL_CONFIG_SYNC_LARK_CLI=/opt/knowledge-kb-model-sync/node_modules/.bin/lark-cli
MODEL_CONFIG_SYNC_DOCKER_CLI=/usr/local/bin/docker
MODEL_CONFIG_SYNC_BACKEND_CONTAINER=kb-backend
MODEL_CONFIG_SYNC_ACTOR=model-configuration-sync
MODEL_CONFIG_SYNC_MAX_RETRIES=3
MODEL_CONFIG_SYNC_COMMAND_TIMEOUT_SECONDS=900
