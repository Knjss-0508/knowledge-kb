# 服务器工作台地址。本机只作为 GPU 训练节点，不运行本项目后端或容器。
# 填写服务器实际入口，不要包含 /app 或 /api/v1。
TRAINING_CONTROL_BASE_URL=https://knowledge.example.com

# 与服务器 EMBEDDING_TRAINING_RUNNER_TOKEN 完全一致，至少 24 位。
TRAINING_RUNNER_TOKEN=

# 本机 Runner 的稳定标识和页面显示名称。
TRAINING_RUNNER_ID=local-rtx4070
TRAINING_RUNNER_NAME=本地 RTX 4070

# 没有任务时的轮询间隔。
TRAINING_POLL_SECONDS=10

# 训练时默认使用的 GPU。
CUDA_VISIBLE_DEVICES=0

# 虚拟环境、模型缓存和训练产物均放在项目目录外。
# 路径中不要使用引号；可按本机磁盘情况调整。
TRAINING_RUNTIME_ROOT=D:\knowledge-kb-training-runtime
