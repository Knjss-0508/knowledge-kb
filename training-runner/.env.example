# 在工作台创建 LoRA 任务后，粘贴任务弹窗生成的完整 URL。
# 使用新部署对外入口提供的 HTTP(S) 任务地址。
TRAINING_JOB_URL=http://qa-kb.10.47.193.5.nip.io/api/v1/embedding-model/runner/tasks/etj-example

# 与上面的任务 URL 一一对应，只能操作该任务，至少 24 位。
TRAINING_JOB_TOKEN=

# 本机 Runner 的稳定标识和页面显示名称。
TRAINING_RUNNER_ID=local-rtx4070
TRAINING_RUNNER_NAME=本地 RTX 4070

# 训练时默认使用的 GPU。
CUDA_VISIBLE_DEVICES=0

# 虚拟环境、模型缓存和训练产物均放在项目目录外。
# 路径中不要使用引号；可按本机磁盘情况调整。
TRAINING_RUNTIME_ROOT=D:\knowledge-kb-training-runtime
