{
  "openapi": "3.0.3",
  "info": {
    "title": "Answer Hub Automation",
    "version": "1.0.0",
    "description": "Receive second-part JSON batches or Excel workbooks, query workflow status, retry failed jobs, and download model-review or CZ submission artifacts."
  },
  "servers": [
    {
      "url": "http://host.docker.internal:8780",
      "description": "Answer Hub service running on the Docker host"
    }
  ],
  "security": [
    {
      "AnswerHubKey": []
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "answerHubHealth",
        "summary": "Check Answer Hub API health",
        "security": [],
        "responses": {
          "200": {
            "description": "Service health",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/automation/jobs": {
      "post": {
        "operationId": "createAnswerHubJob",
        "summary": "Upload a second-part workbook and create an automation job",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "source_file"
                ],
                "properties": {
                  "source_file": {
                    "type": "string",
                    "format": "binary",
                    "description": "Second-part workbook in .xlsx or .xlsm format"
                  },
                  "product_type": {
                    "type": "string"
                  },
                  "use_mimo": {
                    "type": "boolean",
                    "default": true
                  },
                  "clustering_mode": {
                    "type": "string",
                    "enum": [
                      "direct_mimo",
                      "semantic_mimo",
                      "semantic",
                      "rule"
                    ],
                    "default": "direct_mimo"
                  },
                  "semantic_threshold": {
                    "type": "number",
                    "default": 0.84
                  },
                  "cluster_review_floor": {
                    "type": "number",
                    "default": 0.75
                  },
                  "cluster_auto_merge_threshold": {
                    "type": "number",
                    "default": 0.92
                  },
                  "cluster_review_limit": {
                    "type": "integer",
                    "default": 100
                  },
                  "sync_to_cz_review": {
                    "type": "boolean",
                    "default": false
                  }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Job created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AutomationJob"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/v1/automation/second-part/records:batch": {
      "post": {
        "operationId": "pushSecondPartRecords",
        "summary": "Receive a redacted second-part JSON batch and create an automation job",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "idempotency_key",
                  "items"
                ],
                "properties": {
                  "source_system": {
                    "type": "string",
                    "default": "second-part"
                  },
                  "idempotency_key": {
                    "type": "string",
                    "description": "Stable batch key. Repeating identical data reuses the original automation job."
                  },
                  "options": {
                    "type": "object",
                    "properties": {
                      "product_type": {
                        "type": "string"
                      },
                      "use_mimo": {
                        "type": "boolean",
                        "default": true
                      },
                      "clustering_mode": {
                        "type": "string",
                        "enum": [
                          "direct_mimo",
                          "semantic_mimo",
                          "semantic",
                          "rule"
                        ],
                        "default": "direct_mimo"
                      },
                      "sync_to_cz_review": {
                        "type": "boolean",
                        "default": false
                      },
                      "continue_on_mimo_unavailable": {
                        "type": "boolean",
                        "default": false
                      }
                    }
                  },
                  "items": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 100,
                    "items": {
                      "type": "object",
                      "required": [
                        "redaction_status",
                        "record"
                      ],
                      "properties": {
                        "event_id": {
                          "type": "string"
                        },
                        "redaction_status": {
                          "type": "string",
                          "enum": [
                            "redacted"
                          ]
                        },
                        "record": {
                          "type": "object",
                          "description": "Second-part source fields such as 工单ID、聊天内容、产品类型、核心问题、判定结论 and 历史实际回复.",
                          "additionalProperties": true
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Existing job reused for the same idempotency key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AutomationJob"
                }
              }
            }
          },
          "202": {
            "description": "JSON batch accepted and job queued",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AutomationJob"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/v1/automation/jobs/{job_id}": {
      "get": {
        "operationId": "getAnswerHubJob",
        "summary": "Get automation job status and artifact URLs",
        "parameters": [
          {
            "$ref": "#/components/parameters/JobId"
          }
        ],
        "responses": {
          "200": {
            "description": "Current job status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AutomationJob"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/v1/automation/jobs/{job_id}/retry": {
      "post": {
        "operationId": "retryAnswerHubJob",
        "summary": "Move a failed job back to the pending queue",
        "parameters": [
          {
            "$ref": "#/components/parameters/JobId"
          }
        ],
        "responses": {
          "202": {
            "description": "Job requeued",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AutomationJob"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/v1/automation/jobs/{job_id}/artifacts/{artifact_name}": {
      "get": {
        "operationId": "downloadAnswerHubArtifact",
        "summary": "Download a generated workbook or JSON result",
        "parameters": [
          {
            "$ref": "#/components/parameters/JobId"
          },
          {
            "name": "artifact_name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "record_review",
                "topic_review",
                "candidate_knowledge",
                "model_review",
                "cz_submission",
                "summary"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Artifact file",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "AnswerHubKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Answer-Hub-Key"
      }
    },
    "parameters": {
      "JobId": {
        "name": "job_id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        }
      }
    },
    "schemas": {
      "AutomationJob": {
        "type": "object",
        "properties": {
          "job_id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "processing",
              "completed",
              "failed"
            ]
          },
          "run_id": {
            "type": "string"
          },
          "current_stage": {
            "type": "object",
            "additionalProperties": true
          },
          "summary": {
            "type": "object",
            "additionalProperties": true
          },
          "artifact_urls": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "error": {
            "type": "string"
          }
        }
      }
    },
    "responses": {
      "Error": {
        "description": "Request failed",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "error": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
