# Copy this file to .env. Do not commit or paste real API keys into Excel, browser code, or logs.
# Recommended low-cost setup: MiMo V2.5 handles both text and media.
MIMO_API_KEY=
# Optional backup keys, separated by commas or semicolons. The client switches
# only when the active key is out of balance/quota or cannot authenticate.
MIMO_API_KEYS=
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.5
# Full-modal model used when clustering rows contain image or video links.
MIMO_MEDIA_MODEL=mimo-v2.5
MIMO_TIMEOUT_SECONDS=60
MIMO_RESPONSE_READ_TIMEOUT_SECONDS=90
MIMO_RESPONSE_TIMEOUT_CIRCUIT_BREAKER_FAILURES=2
MIMO_THINKING_TYPE=disabled
MIMO_MAX_COMPLETION_TOKENS=2048
MIMO_MAX_RETRIES=2
MIMO_RETRY_BACKOFF_SECONDS=0.75
MIMO_MAX_REQUESTS_PER_SECOND=2
# For clustering, use chat evidence first and attach images only when the
# conversation is too short. Video evidence stays attached.
MIMO_CLUSTER_MEDIA_POLICY=on_demand
MIMO_CLUSTER_MEDIA_MIN_TEXT_CHARS=220
# USD pricing used only for local cost estimation. These values use the
# official uncached-input and output prices for mimo-v2.5 on 2026-08-01.
MIMO_INPUT_COST_PER_MILLION_TOKENS=0.14
MIMO_OUTPUT_COST_PER_MILLION_TOKENS=0.28
ANSWER_HUB_DB_PATH=data/answer_hub.db

# Runtime operations, SLA and retention.
ANSWER_HUB_MIMO_MAX_WORKERS=4
ANSWER_HUB_DIRECT_CLUSTER_MAX_WORKERS=4
ANSWER_HUB_DIRECT_ATOMIC_BATCH_SIZE=4
ANSWER_HUB_DIRECT_ATOMIC_BATCH_MAX_CHARS=16000
ANSWER_HUB_DIRECT_MIMO_BATCH_SIZE=6
ANSWER_HUB_DIRECT_PROGRESS_FLUSH_EVERY=5
# Local quality rules still inspect candidates from 0.40 upward. MiMo is
# called only for stronger candidates and is capped per run.
ANSWER_HUB_DIRECT_RECONCILE_MODEL_FLOOR=0.68
ANSWER_HUB_DIRECT_RECONCILE_LIMIT=24
# Only clusters at or above this confidence, with no risk flags, continue to
# topic classification, value judgment, transcription and initial review.
ANSWER_HUB_CLUSTER_ADMISSION_MIN_CONFIDENCE=0.75
# Stop a full automation run when clustering or atomic extraction failures
# reach this ratio; failed runs remain retryable and are not sent to CZ.
ANSWER_HUB_CLUSTER_FAILURE_ABORT_RATIO=0.5
# Maximum MiMo calls for topic value classification, transcription and initial review
# in one run. Remaining topics stay local and enter human-priority review.
# 主题分类、知识转写、必要重写和内容初审共享调用预算。
ANSWER_HUB_TOPIC_MODEL_CALL_LIMIT=1000
ANSWER_HUB_REDACTION_ENFORCE=true
ANSWER_HUB_SLA_SECONDS_PER_100_ROWS=900
ANSWER_HUB_SLA_MAX_FAILURE_RATE=0.05
ANSWER_HUB_SLA_MAX_FALLBACK_RATE=0.20
ANSWER_HUB_MAX_RUN_COST=50
ANSWER_HUB_RETENTION_DAYS=30

# Optional product taxonomy override. Empty uses the packaged ten-category default.
ANSWER_HUB_PRODUCT_TAXONOMY_PATH=

# OpenAI-compatible embedding service used by semantic topic clustering.
EMBEDDING_BASE_URL=http://127.0.0.1:8080/v1
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_API_KEY=
EMBEDDING_TIMEOUT_SECONDS=120
EMBEDDING_BATCH_SIZE=8
EMBEDDING_MAX_RETRIES=3
EMBEDDING_BATCH_CHAR_LIMIT=1600
EMBEDDING_MAX_TEXT_CHARS=1600
EMBEDDING_CACHE_SIZE=5000

# CZ knowledge-base integration. Keep the key server-side only.
KB_BASE_URL=
KB_INTEGRATION_KEY=
# Read-only CZ standard-search key. When configured, only published
# headquarters_standard knowledge is retrieved after topic admission. When a
# local compiled quality-standard catalog is also configured, CZ matches win.
KB_RETRIEVAL_API_KEY=
KB_TIMEOUT_SECONDS=30
KB_MAX_RETRIES=3
KB_RETRY_BACKOFF_SECONDS=0.5

# Model auto-review rollout. Keep disabled while teammates create validation gold labels.
AUTO_REVIEW_ENABLED=false
AUTO_REVIEW_KILL_SWITCH=false
# Comma-separated product names. Empty means all validated products only after explicit enablement.
AUTO_REVIEW_PRODUCT_TYPES=
AUTO_REVIEW_MIN_CONFIDENCE=0.85
AUTO_REVIEW_MIN_VALIDATION_SAMPLES=40
AUTO_REVIEW_MIN_VALIDATION_ACCURACY=0.90
AUTO_REVIEW_MIN_PASS_PRECISION=0.95
# Fill these only after the exact model and prompt version pass validation.
AUTO_REVIEW_VALIDATED_MODEL=
AUTO_REVIEW_VALIDATED_PROMPT_VERSION=

# Unattended workbook automation. Drop .xlsx/.xlsm files into the pending folder.
# Full automation uses direct MiMo clustering; low-confidence or degraded
# clusters stop in the manual cluster-review queue before downstream models.
ANSWER_HUB_AUTOMATION_QUEUE=data/automation-queue
ANSWER_HUB_AUTOMATION_OUTPUT=outputs/automation-runs
ANSWER_HUB_RUN_FEEDBACK_PATH=data/automation-queue/run_feedback.db
ANSWER_HUB_AUTOMATION_STANDARDS=
# Optional classification recall index (JSON or JSONL). It supplements
# clustering only; curated clustering rules remain the hard boundary.
ANSWER_HUB_CLUSTERING_CLASSIFICATION_CATALOG=
ANSWER_HUB_AUTOMATION_PRODUCT_TYPE=
ANSWER_HUB_AUTOMATION_USE_MIMO=true
ANSWER_HUB_AUTOMATION_CLUSTERING_MODE=direct_mimo
# Sync every model-reviewed topic to CZ candidate value review. This does not
# create or publish knowledge; CZ reviewers must click batch submit afterward.
ANSWER_HUB_AUTOMATION_SYNC_TO_CZ_REVIEW=false
# Deprecated compatibility alias. Used only when the new variable is empty.
ANSWER_HUB_AUTOMATION_SUBMIT_TO_CZ=false
ANSWER_HUB_AUTOMATION_MAX_FILES=10
ANSWER_HUB_AUTOMATION_STALE_AFTER_SECONDS=7200

# Optional scheduled pull from the second-part JSON API. Copy
# config/second-part-pull.example.json to a local profile, then update the URL,
# response paths and field mapping to match the real API. Keep tokens only here.
SECOND_PART_PULL_PROFILE=
SECOND_PART_PULL_STATE=data/second-part-pull/state.json
SECOND_PART_PULL_MAX_PAGES=10
SECOND_PART_API_TOKEN=
# PowerZhuan QA 手工联调范围，格式 YYYY-MM-DD；两项必须同时填写。
SECOND_PART_QUERY_FROM_DATE=
SECOND_PART_QUERY_TO_DATE=
# 兼容旧的单日手工联调配置；新配置优先使用上面的 FROM/TO。
SECOND_PART_QUERY_DATE=
# 未显式设置 FROM/TO 时，定时任务拉取前 N 个完整自然日；每天一次填 1，每 3 天一次填 3。
SECOND_PART_QUERY_WINDOW_DAYS=1

# Dify calls this API through http://host.docker.internal:8780.
# Generate a long random value locally; never commit the real key.
ANSWER_HUB_API_KEY=
ANSWER_HUB_API_HOST=0.0.0.0
ANSWER_HUB_API_PORT=8780
